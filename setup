#!/bin/bash

# VenusOS-E3372h setup script
# Huawei E3372h (NCM mode) modem integration for Venus OS
#
# This script installs/uninstalls:
#   - D-Bus modem service (via SetupHelper service mechanism)
#   - Replacement start-modem.sh for serial-starter (via FileSets)
#   - udev rules for hotplug
#   - NCM connect script
#   - USB reset helper and link watchdog (recovery ladder)
#   - Default config file (preserves existing)

packageDir="$(dirname "$(realpath "$0")")"

# custom install/uninstall actions needed
# standardPromptAndActions='yes'  # NOT used — we have custom actions

#### following line incorporates helper resources into this script
source "/data/SetupHelper/HelperResources/IncludeHelpers"
#### end of lines to include helper resources

# Stop every running copy of the link watchdog, whatever its pidfile says.
stop_linkwatch() {
    for d in /proc/[0-9]*; do
        tr '\0' ' ' < "$d/cmdline" 2>/dev/null | grep -q 'e3372_linkwatch\.sh' && kill -9 "${d#/proc/}" 2>/dev/null
    done
    rm -f /var/run/e3372-linkwatch.pid
}

#### running manually and target just install or uninstall
if [ $scriptAction == 'NONE' ] ; then
    echo
    echo "This package adds Huawei E3372h (NCM mode) modem support to Venus OS"
    echo
    scriptAction=$(promptForAction)
fi

if [ $scriptAction == 'INSTALL' ] ; then
    logMessage "installing VenusOS-E3372h"

    # Install udev rules
    cp "$packageDir/udev-e3372.rules" /data/udev-e3372.rules
    sed -i 's/\r//g' /data/udev-e3372.rules
    ln -sf /data/udev-e3372.rules /etc/udev/rules.d/99-e3372.rules
    udevadm control --reload-rules 2>/dev/null
    logMessage "udev rules installed"

    # Install the helpers into /data. Each one is written to a temporary file
    # and renamed into place: a copy that is running right now (the link
    # watchdog runs for ever) keeps reading its old file instead of having it
    # truncated and rewritten under its feet. CR is stripped in case the package
    # came from a Windows working tree (CRLF breaks the shebang on BusyBox).
    install_helper() {
        cp "$packageDir/$1" "/data/$1.new" &&
        sed -i 's/\r//g' "/data/$1.new" &&
        chmod +x "/data/$1.new" &&
        mv -f "/data/$1.new" "/data/$1"
    }
    install_helper e3372_connect.sh     # NCM link bring-up, run by udev
    install_helper e3372_usb_reset.sh   # USB rungs, run detached
    install_helper e3372_linkwatch.sh   # last-resort watchdog, runs detached
    install_helper e3372_at.py          # AT queries on the second channel
    logMessage "helpers installed"

    # Restart the link watchdog on the new code: a running copy would carry
    # on with the old one for as long as the GX stays up. Up to v1.4 it also
    # swallowed SIGTERM, so every copy is stopped with SIGKILL - it holds no
    # state that needs a clean exit, and a USB helper it may have started
    # runs on its own and undoes itself.
    stop_linkwatch
    setsid nohup /data/e3372_linkwatch.sh > /dev/null 2>&1 &
    logMessage "link watchdog restarted"

    # Persistent recovery journal
    mkdir -p /data/log/e3372

    # Install config file (only if not already present — preserve user edits)
    if [ ! -f /data/e3372-config.conf ] ; then
        cp "$packageDir/e3372-config.conf" /data/e3372-config.conf
        sed -i 's/\r//g' /data/e3372-config.conf
        logMessage "default config installed (/data/e3372-config.conf)"
    else
        logMessage "config file already exists, preserved"
    fi

    # Make dbus service executable
    # (run in place from $packageDir by the serial-starter start-modem.sh)
    sed -i 's/\r//g' "$packageDir/dbus-modem-e3372.py"
    chmod +x "$packageDir/dbus-modem-e3372.py"
    logMessage "line endings normalized (LF)"

    # Load modem kernel modules
    modprobe huawei_cdc_ncm 2>/dev/null
    modprobe cdc_ncm 2>/dev/null

fi

if [ $scriptAction == 'UNINSTALL' ] ; then
    logMessage "uninstalling VenusOS-E3372h"

    # Remove udev rules
    rm -f /etc/udev/rules.d/99-e3372.rules
    rm -f /data/udev-e3372.rules
    udevadm control --reload-rules 2>/dev/null
    logMessage "udev rules removed"

    # Remove NCM connect script
    rm -f /data/e3372_connect.sh
    logMessage "NCM connect script removed"

    # Remove the helpers (the recovery journal in /data/log/e3372 is kept)
    stop_linkwatch
    rm -f /data/e3372_usb_reset.sh /data/e3372_linkwatch.sh /data/e3372_at.py
    logMessage "USB reset helper and link watchdog removed"

    # Note: /data/e3372-config.conf is NOT removed (user data)
    logMessage "config file preserved (/data/e3372-config.conf)"
fi

# Let SetupHelper handle:
#   INSTALL_FILES — replaces start-modem.sh from FileSets
#
# NOTE: this package deliberately installs NO runit service.
# The modem service is launched by serial-starter, not by runit:
#   udev (VE_SERVICE=modem) -> serial-starter -> start-modem.sh (FileSet)
#     -> dbus-modem-e3372.py -s /dev/$tty
# $tty is set by serial-starter's run-service.sh and is NOT available to a
# standalone runit service. A services/ entry here would therefore exec
# "-s /dev/" and respawn-loop, while also fighting the working instance for
# ownership of the com.victronenergy.modem D-Bus name.
# Do NOT add INSTALL_SERVICES to the line below.
endScript INSTALL_FILES
